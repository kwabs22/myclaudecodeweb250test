  "benchmark_tests": {
    "quick_test": {
      "description": "Fast benchmark for testing setup",
      "prompt": "Hello, how are you?",
      "max_tokens": 50,
      "iterations": 3
    },
    "standard_test": {
      "description": "Standard benchmark (7B model)",
      "prompt": "Write a detailed explanation of machine learning in simple terms.",
      "max_tokens": 256,
      "iterations": 10
    },
    "throughput_test": {
      "description": "High throughput test",
      "prompt": "Generate a list of 20 creative project ideas.",
      "max_tokens": 500,
      "iterations": 5
    },
    "latency_test": {
      "description": "Low latency test (short responses)",
      "prompt": "What is 2+2?",
      "max_tokens": 10,
      "iterations": 20
    },
    "stress_test": {
      "description": "Stress test with long context",
      "prompt": "Write a comprehensive analysis of cloud computing architectures, including serverless, containerization, microservices, edge computing, and hybrid cloud strategies. Cover benefits, challenges, and best practices.",
      "max_tokens": 1000,
      "iterations": 3
    }
  },
  "model_configurations": {
