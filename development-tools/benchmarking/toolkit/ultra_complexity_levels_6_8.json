          "verdict": "Multi-model saves time and money, higher quality"
        },
        "scenario_2": {
          "task": "Build simple CRUD app",
          "option_a_single_model": {
            "cost": "$720/month × 1 month = $720",
            "timeline": "1 week",
            "quality": "90%",
            "risk": "Low"
          },
          "option_b_multi_model": {
            "cost": "$5,000/month × 1 month = $5,000",
            "timeline": "3 days",
            "quality": "95%",
            "risk": "Low"
          },
          "verdict": "Single model better - don't over-engineer"
        }
      },

      "rule_of_thumb": "Use multi-model when: (Time savings value + Quality improvement value) > Additional cost"
    }
  }
