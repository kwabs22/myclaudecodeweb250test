# GPU Provider Configuration
# Copy this file to .env and fill in your API keys

# Modal Labs API Token
MODAL_TOKEN_ID=your_modal_token_id
MODAL_TOKEN_SECRET=your_modal_token_secret

# Blaxel API Configuration
BLAXEL_API_KEY=your_blaxel_api_key
BLAXEL_API_URL=https://api.blaxel.com/v1

# Default GPU Provider (options: modal, blaxel, zero_gpu)
DEFAULT_GPU_PROVIDER=modal

# Fallback order (comma-separated)
GPU_FALLBACK_ORDER=modal,blaxel,zero_gpu

# Timeout settings (seconds)
REQUEST_TIMEOUT=300
FALLBACK_RETRY_ATTEMPTS=3
