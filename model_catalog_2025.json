    "qualitative_metrics": {
      "description": "Updated qualitative comparison dimensions for 2025",
      "dimensions": [
        {
          "name": "instruction_following",
          "description": "How well model follows complex instructions",
          "test_prompts": [
            "Write a Python function that takes a list and returns only even numbers, then explain each line with comments.",
            "Create a markdown table comparing Python, JavaScript, and Rust on: syntax, performance, use cases."
          ]
        },
        {
          "name": "reasoning",
          "description": "Logical reasoning and problem-solving ability",
          "test_prompts": [
            "If a train leaves at 3pm going 60mph and another at 4pm going 80mph, when will they meet if starting 140 miles apart? Show your work.",
            "Explain why correlation does not imply causation with a real-world example."
          ]
        },
        {
          "name": "code_generation",
          "description": "Code quality and correctness",
          "test_prompts": [
            "Write a binary search function in Python with type hints and comprehensive docstrings.",
            "Create a REST API endpoint using FastAPI for user authentication with JWT tokens."
          ]
        },
        {
          "name": "long_context",
          "description": "Handling 100K+ context windows effectively",
          "test_prompts": [
            "Summarize the key points from this 10,000 word technical document: [long text]",
            "Find all mentions of 'security' across these 50 emails and identify patterns."
          ]
        },
        {
          "name": "multilingual",
          "description": "Performance across multiple languages",
          "test_prompts": [
            "Translate this English paragraph to Chinese, then explain the cultural nuances.",
            "Write a function in Python with Chinese variable names and English comments."
          ]
        },
        {
          "name": "tool_use",
          "description": "Function calling and tool integration",
          "test_prompts": [
            "Given these functions, create a plan to fetch weather data and send an email: [function definitions]",
            "Use the calculator tool to solve this complex equation: [equation]"
          ]
        },
        {
          "name": "factual_accuracy",
          "description": "Factual correctness and up-to-date knowledge",
          "test_prompts": [
            "Explain the key features introduced in Python 3.12.",
            "What are the main differences between NVIDIA H100 and B200 GPUs?"
          ]
        },
        {
